# RetroWeb web app (Next.js standalone build)
FROM node:22-alpine AS build
WORKDIR /repo

# The API rewrite target is baked into the Next.js config at build time.
ARG API_PROXY_TARGET=http://api:8000
ARG NEXT_PUBLIC_APP_NAME=RetroWeb
ENV API_PROXY_TARGET=$API_PROXY_TARGET \
    NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME \
    NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/emulator-core/package.json packages/emulator-core/package.json
RUN npm ci

COPY apps/web apps/web
COPY packages packages
COPY scripts scripts
# Emulator runtime + cores (emulator software only, no game content).
RUN node scripts/fetch-emulatorjs.mjs
RUN npm run build --workspace apps/web

FROM node:22-alpine AS runtime
WORKDIR /repo
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /repo/apps/web/public ./apps/web/public

USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
