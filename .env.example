# ---------------------------------------------------------------------------
# RetroWeb configuration (copy to .env). Never commit real secrets.
# ---------------------------------------------------------------------------

# Product name shown in the UI and API. Not hard-coded anywhere else.
APP_NAME=RetroWeb
NEXT_PUBLIC_APP_NAME=RetroWeb

# --- Backend (apps/api) ------------------------------------------------------
# SQLite for development. PostgreSQL example:
#   DATABASE_URL=postgresql+psycopg://retroweb:retroweb@db:5432/retroweb
DATABASE_URL=sqlite:///./data/retroweb.db

# Root of all user data. Sub-paths default to <DATA_PATH>/<kind> and can be
# overridden individually.
DATA_PATH=./data
ROM_PATH=
SAVE_PATH=
STATE_PATH=
BIOS_PATH=
COVER_PATH=
SCREENSHOT_PATH=

# Used for session cookies once authentication is enabled. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Phase 1 runs with a single implicit user. Set to false once accounts exist.
SINGLE_USER_MODE=true

# Upload limits (bytes)
MAX_ROM_UPLOAD_BYTES=2147483648
MAX_SAVE_UPLOAD_BYTES=67108864
MAX_COVER_UPLOAD_BYTES=5242880

# Cover art from the libretro-thumbnails collection, fetched only when you ask
# (game page or Settings). Never games or BIOS files.
ONLINE_METADATA=true
THUMBNAILS_BASE_URL=https://thumbnails.libretro.com

# console | json
LOG_FORMAT=console
LOG_LEVEL=INFO

# Comma separated origins allowed to call the API directly (the web app proxies
# /api so this is only needed for tooling).
CORS_ORIGINS=http://localhost:3000

# --- Frontend (apps/web) -----------------------------------------------------
# Where the Next.js server forwards /api/* requests (server-side only).
API_PROXY_TARGET=http://localhost:8000

# Send COOP/COEP headers so SharedArrayBuffer is available to emulator cores
# that need threads (PPSSPP, DOSBox). Safe to keep on: everything is same-origin.
CROSS_ORIGIN_ISOLATION=true
