[Unit]
Description=fnOS NAS roms share (rclone alias remote fnosroms) mounted read-only at ~/mnt/fnos-roms
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
# remotes "fnos" (smb) and "fnosroms" (alias to the share) are written to ~/.config/rclone/rclone.conf by deploy/nas-mount-setup.sh
ExecStart=%h/.local/bin/rclone mount fnosroms: %h/mnt/fnos-roms \
    --read-only \
    --vfs-cache-mode off \
    --buffer-size 64M \
    --vfs-read-chunk-size 32M \
    --dir-cache-time 2m \
    --attr-timeout 1m \
    --poll-interval 0 \
    --umask 022 \
    --log-level NOTICE
ExecStop=/usr/bin/fusermount3 -uz %h/mnt/fnos-roms
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
