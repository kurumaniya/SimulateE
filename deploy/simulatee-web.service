[Unit]
Description=SimulateE (RetroWeb) web - Next.js standalone on 0.0.0.0:3000
After=network.target simulatee-api.service
Wants=simulatee-api.service

[Service]
WorkingDirectory=%h/simulatee/run/web
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=HOSTNAME=0.0.0.0
Environment=PORT=3000
ExecStart=%h/.local/node/bin/node apps/web/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
